<%@ page import="java.util.*,models.*" %><%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><title>My Reviews</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/catalog">Book<span>Nest</span></a><div class="navlinks"><a href="<%=request.getContextPath()%>/catalog">Store</a><% if(session.getAttribute("userId")!=null){ %><a href="<%=request.getContextPath()%>/orders">My Orders</a><a href="<%=request.getContextPath()%>/reviews">Reviews</a>
<a href="<%=request.getContextPath()%>/profile">Profile</a><% if("ADMIN".equals(session.getAttribute("userRole"))){ %><a href="<%=request.getContextPath()%>/admin/dashboard">Admin</a><% } %><a class="btn" href="<%=request.getContextPath()%>/logout">Logout</a><% } else { %><a href="<%=request.getContextPath()%>/login.jsp">Login</a><a class="btn primary" href="<%=request.getContextPath()%>/register.jsp">Register</a><% } %></div></nav><main class="container"><h1>My Reviews</h1><div class="panel"><h2>Write a Review</h2><form method="post" class="form-grid"><input type="hidden" name="action" value="create"><div><label>Book</label><select name="bookId"><% for(Book b:(List<Book>)request.getAttribute("books")){%><option value="<%=b.getId()%>"><%=b.getTitle()%></option><%}%></select></div><div><label>Rating</label><select name="rating"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select></div><div class="full"><label>Comment</label><textarea name="comment" required></textarea></div><div class="full"><button class="btn primary">Submit Review</button></div></form></div><div class="panel table-wrap"><table><tr><th>Book</th><th>Rating</th><th>Comment</th><th>Status</th><th>Actions</th></tr><% for(Review v:(List<Review>)request.getAttribute("reviews")){%><tr><form method="post"><td><%=v.getBookTitle()%><input type="hidden" name="id" value="<%=v.getId()%>"></td><td><input type="number" min="1" max="5" name="rating" value="<%=v.getRating()%>"></td><td><input name="comment" value="<%=v.getComment()%>"></td><td><%=v.isApproved()?"Approved":"Pending"%></td><td class="actions"><button class="btn success" name="action" value="update">Update</button><button class="btn danger" name="action" value="delete">Delete</button></td></form></tr><%}%></table></div></main></body></html>