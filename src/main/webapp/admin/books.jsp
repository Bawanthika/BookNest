<%@ page import="java.util.*,models.*" %><%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><title>Books</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/catalog">Book<span>Nest</span></a><div class="navlinks"><a href="<%=request.getContextPath()%>/catalog">Store</a><% if(session.getAttribute("userId")!=null){ %><a href="<%=request.getContextPath()%>/orders">My Orders</a><a href="<%=request.getContextPath()%>/reviews">Reviews</a><% if("ADMIN".equals(session.getAttribute("userRole"))){ %><a href="<%=request.getContextPath()%>/admin/dashboard">Admin</a><% } %><a class="btn" href="<%=request.getContextPath()%>/logout">Logout</a><% } else { %><a href="<%=request.getContextPath()%>/login.jsp">Login</a><a class="btn primary" href="<%=request.getContextPath()%>/register.jsp">Register</a><% } %></div></nav><div class="admin-shell"><aside class="side"><h3>Admin Panel</h3><a href="<%=request.getContextPath()%>/admin/dashboard">Dashboard</a><a href="<%=request.getContextPath()%>/admin/users">Users</a><a href="<%=request.getContextPath()%>/admin/books">Books</a><a href="<%=request.getContextPath()%>/admin/authors">Authors</a><a href="<%=request.getContextPath()%>/admin/categories">Categories</a><a href="<%=request.getContextPath()%>/orders">Orders</a><a href="<%=request.getContextPath()%>/reviews">Reviews</a></aside><main class="content"><h1>Book Management</h1><div class="panel"><h2>Add Book</h2><form method="post" class="form-grid"><input type="hidden" name="action" value="create"><div><label>ISBN</label><input name="isbn" required></div><div><label>Title</label><input name="title" required></div><div><label>Author</label><select name="authorId"><% for(Author a:(List<Author>)request.getAttribute("authors")){%><option value="<%=a.getId()%>"><%=a.getName()%></option><%}%></select></div><div><label>Category</label><select name="categoryId"><% for(Category c:(List<Category>)request.getAttribute("categories")){%><option value="<%=c.getId()%>"><%=c.getName()%></option><%}%></select></div><div><label>Price</label><input type="number" step="0.01" name="price" required></div><div><label>Stock</label><input type="number" name="stock" required></div><div><label>Format</label><select name="format"><option>PRINTED</option><option>EBOOK</option></select></div><div><label>Image URL (optional)</label><input name="imageUrl"></div><div class="full"><label>Description</label><textarea name="description"></textarea></div><div class="full"><button class="btn primary">Add Book</button></div></form></div><div class="panel table-wrap"><table><tr><th>ID</th><th>Book</th><th>Price</th><th>Stock</th><th>Format</th><th>Actions</th></tr><% for(Book b:(List<Book>)request.getAttribute("books")){%><tr><form method="post"><td><%=b.getId()%><input type="hidden" name="id" value="<%=b.getId()%>"><input type="hidden" name="isbn" value="<%=b.getIsbn()%>"><input type="hidden" name="authorId" value="<%=b.getAuthorId()%>"><input type="hidden" name="categoryId" value="<%=b.getCategoryId()%>"><input type="hidden" name="description" value="<%=b.getDescription()==null?"":b.getDescription()%>"><input type="hidden" name="imageUrl" value="<%=b.getImageUrl()==null?"":b.getImageUrl()%>"></td><td><input name="title" value="<%=b.getTitle()%>"><small class="muted"><%=b.getAuthorName()%></small></td><td><input type="number" step="0.01" name="price" value="<%=b.getPrice()%>"></td><td><input type="number" name="stock" value="<%=b.getStock()%>"></td><td><select name="format"><option <%=b.getFormat().equals("PRINTED")?"selected":""%>>PRINTED</option><option <%=b.getFormat().equals("EBOOK")?"selected":""%>>EBOOK</option></select></td><td class="actions"><button class="btn success" name="action" value="update">Update</button><button class="btn danger" name="action" value="delete">Delete</button></td></form></tr><%}%></table></div></main></div></body></html>