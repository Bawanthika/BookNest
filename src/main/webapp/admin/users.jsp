<%@ page import="java.util.*,models.User" %><%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><title>User Management</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/catalog">Book<span>Nest</span></a><div class="navlinks"><a href="<%=request.getContextPath()%>/catalog">Store</a><% if(session.getAttribute("userId")!=null){ %><a href="<%=request.getContextPath()%>/orders">My Orders</a><a href="<%=request.getContextPath()%>/reviews">Reviews</a><% if("ADMIN".equals(session.getAttribute("userRole"))){ %><a href="<%=request.getContextPath()%>/admin/dashboard">Admin</a><% } %><a class="btn" href="<%=request.getContextPath()%>/logout">Logout</a><% } else { %><a href="<%=request.getContextPath()%>/login.jsp">Login</a><a class="btn primary" href="<%=request.getContextPath()%>/register.jsp">Register</a><% } %></div></nav><div class="admin-shell"><aside class="side"><h3>Admin Panel</h3><a href="<%=request.getContextPath()%>/admin/dashboard">Dashboard</a><a href="<%=request.getContextPath()%>/admin/users">Users</a><a href="<%=request.getContextPath()%>/admin/books">Books</a><a href="<%=request.getContextPath()%>/admin/authors">Authors</a><a href="<%=request.getContextPath()%>/admin/categories">Categories</a><a href="<%=request.getContextPath()%>/orders">Orders</a><a href="<%=request.getContextPath()%>/reviews">Reviews</a></aside><main class="content"><h1>User Management</h1><div class="panel"><h2>Create User</h2><form method="post" class="form-grid"><input type="hidden" name="action" value="create"><div><label>Full Name</label><input name="fullName" required></div><div><label>Email</label><input type="email" name="email" required></div><div><label>Password</label><input name="password" type="password" required></div><div><label>Role</label><select name="role"><option>CUSTOMER</option><option>ADMIN</option></select></div><div class="full"><button class="btn primary">Create</button></div></form></div><div class="panel table-wrap"><table><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Update / Delete</th></tr><% for(User u:(List<User>)request.getAttribute("users")){ %><tr><form method="post"><td><%=u.getId()%><input type="hidden" name="id" value="<%=u.getId()%>"></td><td><input name="fullName" value="<%=u.getFullName()%>"></td><td><input name="email" value="<%=u.getEmail()%>"></td><td><select name="role"><option <%=u.getRole().equals("CUSTOMER")?"selected":""%>>CUSTOMER</option><option <%=u.getRole().equals("ADMIN")?"selected":""%>>ADMIN</option></select></td><td class="actions"><button class="btn success" name="action" value="update">Update</button><button class="btn danger" name="action" value="delete" onclick="return confirm('Delete user?')">Delete</button></td></form></tr><%}%></table></div></main></div></body></html>