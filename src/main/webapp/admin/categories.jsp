<%@ page import="java.util.*,models.Category" %><%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html><head><title>Categories</title><link rel="stylesheet" href="<%=request.getContextPath()%>/assets/css/style.css"></head><body><nav class="nav"><a class="brand" href="<%=request.getContextPath()%>/catalog">Book<span>Nest</span></a><div class="navlinks"><a href="<%=request.getContextPath()%>/catalog">Store</a><% if(session.getAttribute("userId")!=null){ %><a href="<%=request.getContextPath()%>/orders">My Orders</a><a href="<%=request.getContextPath()%>/reviews">Reviews</a><% if("ADMIN".equals(session.getAttribute("userRole"))){ %><a href="<%=request.getContextPath()%>/admin/dashboard">Admin</a><% } %><a class="btn" href="<%=request.getContextPath()%>/logout">Logout</a><% } else { %><a href="<%=request.getContextPath()%>/login.jsp">Login</a><a class="btn primary" href="<%=request.getContextPath()%>/register.jsp">Register</a><% } %></div></nav><div class="admin-shell"><aside class="side"><h3>Admin Panel</h3><a href="<%=request.getContextPath()%>/admin/dashboard">Dashboard</a><a href="<%=request.getContextPath()%>/admin/users">Users</a><a href="<%=request.getContextPath()%>/admin/books">Books</a><a href="<%=request.getContextPath()%>/admin/authors">Authors</a><a href="<%=request.getContextPath()%>/admin/categories">Categories</a><a href="<%=request.getContextPath()%>/orders">Orders</a><a href="<%=request.getContextPath()%>/reviews">Reviews</a></aside><main class="content"><h1>Category Management</h1><div class="panel"><form method="post" class="form-grid"><input type="hidden" name="action" value="create"><div><label>Category Name</label><input name="name" required></div><div><label>Description</label><input name="description"></div><div class="full"><button class="btn primary">Add Category</button></div></form></div><div class="panel table-wrap"><table><tr><th>ID</th><th>Name</th><th>Description</th><th>Actions</th></tr><% for(Category a:(List<Category>)request.getAttribute("categories")){%><tr><form method="post"><td><%=a.getId()%><input type="hidden" name="id" value="<%=a.getId()%>"></td><td><input name="name" value="<%=a.getName()%>"></td><td><input name="description" value="<%=a.getDescription()==null?"":a.getDescription()%>"></td><td class="actions"><button class="btn success" name="action" value="update">Update</button><button class="btn danger" name="action" value="delete">Delete</button></td></form></tr><%}%></table></div></main></div></body></html>